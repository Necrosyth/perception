# AIna Sentinel — environment template.
# Copy to .env and adjust. Values here are safe dev defaults.

# Deployment target: edge (Jetson) | aws (g4dn/g5 GPU instance).
# Only selects the base image / compiled TensorRT engine — never app logic.
DEPLOYMENT_TARGET=edge

# Postgres (pgvector)
POSTGRES_USER=aina
POSTGRES_PASSWORD=aina_dev_password
POSTGRES_DB=aina_sentinel
POSTGRES_PORT=5432

# go2rtc media server (restream layer for cameras)
GO2RTC_PORT=1984

# Camera sources (go2rtc). Example RTSP / local-file sources:
# CAM_LOADING_DOCK_SOURCE=rtsp://user:pass@192.168.1.50:554/stream1
# CAM_LOADING_DOCK_NAME=loading_dock

# API / dashboard
API_PORT=5000
DASHBOARD_PORT=3000

# Perception
# Which GPU device index to expose into the perception container (0 = first GPU)
PERCEPTION_GPU_INDEX=0
# Compute capability cache dir (TensorRT .engine files are not portable across GPUs)
ENGINE_CACHE=./.engine_cache