# Perception runtime. Stage 0 = GPU-proof skeleton; Stage 2+ installs the
# orchestrator deps (numpy, pyyaml, supervision, ultralytics, trackers, ...).
# Base image deliberately carries a full NVIDIA driver stack so nvidia-smi
# exists inside the container (GPU passthrough proof). Stage 9 splits this
# into Dockerfile.edge (L4T/Jetson, arm64) and Dockerfile.aws (x86_64 CUDA).

ARG CUDA_BASE=nvidia/cuda:12.4.1-base-ubuntu22.04
FROM ${CUDA_BASE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility,video \
    NVIDIA_DISABLE_REQUIRE=1 \
    YOLO_CONFIG_DIR=/tmp/Ultralytics \
    UV_HTTP_TIMEOUT=300 \
    UV_RETRIES=8

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-setuptools \
        curl ca-certificates ffmpeg libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /srv/aina
COPY perception/pyproject.toml perception/uv.lock /srv/aina/perception/
COPY perception /srv/aina/perception
COPY config/aina.yaml /etc/aina/aina.yaml

# Everything is managed with uv (no pip). The whole runtime — including the
# GPU torch wheel + its NVIDIA/CUDA libs — is resolved from the project lockfile
# in ONE pass (`uv export` -> `uv pip install`), so no step can silently
# re-resolve torch against a second index like the lock's own transitive
# requirements used to. Base-image CUDA dirs are dropped so the lock's bundled
# CUDA runtime is the only one on the path.
RUN --mount=type=cache,target=/root/.cache/uv \
    python3 -m pip install --no-cache-dir uv \
    && RM="rm -rf /usr/local/cuda-12.4 /usr/local/cuda-12 /usr/local/cuda" \
    && UV_CACHE_DIR=/root/.cache/uv python3 -m uv export \
           --project /srv/aina/perception \
           --extra detection --extra db --no-dev --no-hashes \
       > /tmp/aina_deps.txt \
    && UV_CACHE_DIR=/root/.cache/uv python3 -m uv pip install --system -r /tmp/aina_deps.txt \
    && $RM \
    && rm -f /tmp/aina_deps.txt

CMD ["python3", "-u", "-m", "perception.orchestrator"]